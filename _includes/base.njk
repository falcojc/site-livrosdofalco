<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — Domenico Falco</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://www.livrosdofalco.com.br{{ page.url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="https://www.livrosdofalco.com.br{{ cover or '/og-image.jpg' }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
{% if date %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | dateBR }}",
  "author": { "@type": "Person", "name": "Domenico Falco" },
  "publisher": { "@type": "Organization", "name": "Livros do Falco" }
}
</script>
{% endif %}
<style>
  :root{
    --bg:#0b0908;
    --bg-alt:#141110;
    --gold:#c9a13a;
    --gold-bright:#e6c467;
    --text:#efe6d6;
    --text-muted:#a99c85;
    --card-border:#2b241d;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'EB Garamond',Georgia,serif;
    font-size:18px;
    line-height:1.65;
  }
  h1,h2,h3,.brand,.eyebrow,.btn,.post-tag,nav.links a,.foot-links a{font-family:'Cinzel',Georgia,serif;}
  h1,h2{text-wrap:balance;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 28px;}

  header.nav{border-bottom:1px solid var(--card-border);position:sticky;top:0;background:rgba(11,9,8,.94);backdrop-filter:blur(6px);z-index:10;}
  .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;max-width:1080px;margin:0 auto;gap:24px;flex-wrap:wrap;}
  .brand-lockup{display:flex;align-items:center;gap:10px;}
  .brand-lockup img{width:30px;height:30px;}
  .brand{font-weight:700;font-size:18px;letter-spacing:.1em;color:var(--text);}
  .brand span{color:var(--gold);}
  nav.links{display:flex;gap:26px;align-items:center;flex-wrap:wrap;}
  nav.links a{font-size:14px;color:var(--text-muted);font-family:'EB Garamond',Georgia,serif;}
  nav.links a:hover,nav.links a.current{color:var(--gold-bright);}
  @media (max-width:900px){
    .nav-inner{flex-wrap:wrap;row-gap:10px;}
    nav.links{
      order:3;width:100%;flex-wrap:nowrap;overflow-x:auto;gap:22px;
      padding:10px 2px 2px;margin-top:2px;border-top:1px solid var(--card-border);
      -webkit-overflow-scrolling:touch;scrollbar-width:none;
    }
    nav.links::-webkit-scrollbar{display:none;}
    nav.links a{white-space:nowrap;}
    nav.links a.hide-compact{display:none;}
  }
  .cart-btn{
    width:32px;height:32px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;
    border:1px solid var(--gold);border-radius:2px;color:var(--gold-bright);transition:background .2s,color .2s;
  }
  .cart-btn:hover{background:var(--gold);color:var(--bg);}
  .cart-btn svg{width:16px;height:16px;}
  .btn{
    font-family:Cinzel,Georgia,serif;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    border:1px solid var(--gold);color:var(--gold-bright);padding:9px 16px;border-radius:2px;white-space:nowrap;
    transition:background .2s,color .2s;display:inline-block;
  }
  .btn:hover{background:var(--gold);color:var(--bg);}
  .btn.solid{background:var(--gold);color:var(--bg);}
  .btn.solid:hover{background:var(--gold-bright);}

  section{padding:64px 0;}
  .section-label{text-align:center;font-family:Cinzel,serif;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;}
  .sec-head{text-align:center;max-width:640px;margin:0 auto 48px;}
  .sec-head h1{font-size:38px;color:var(--text);margin:0 0 14px;font-weight:600;}
  .divider{width:56px;height:2px;background:var(--gold);margin:0 auto 18px;}
  .sec-head p{color:var(--text-muted);font-size:18px;margin:0;}

  .hero-carousel{position:relative;margin-bottom:48px;border-radius:4px;overflow:hidden;border:1px solid var(--card-border);}
  .hero-track{position:relative;aspect-ratio:21/9;background:var(--bg-alt);}
  .hero-slide{position:absolute;inset:0;display:block;opacity:0;pointer-events:none;transition:opacity .6s ease;}
  .hero-slide.is-active{opacity:1;pointer-events:auto;}
  .hero-slide-bg{position:absolute;inset:0;background-size:cover;background-position:center;}
  .hero-slide-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,9,7,.92) 8%,rgba(10,9,7,.15) 65%);}
  .hero-slide-body{position:absolute;left:0;right:96px;bottom:0;padding:32px;}
  .hero-slide-body .post-tag{color:var(--gold-bright);}
  .hero-slide-body h2{color:var(--text);font-size:28px;margin:10px 0;line-height:1.25;}
  .hero-slide-body p{color:var(--text-muted);font-size:15px;margin:0 0 6px;max-width:620px;}
  .hero-cta{color:var(--gold-bright);font-family:Cinzel,serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;}
  .hero-arrow{
    position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;
    border:1px solid var(--gold);background:rgba(10,9,7,.55);color:var(--gold-bright);font-size:20px;line-height:1;
    display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s,color .2s;z-index:2;
  }
  .hero-arrow:hover{background:var(--gold);color:var(--bg);}
  .hero-prev{left:14px;}
  .hero-next{right:14px;}
  .hero-dots{position:absolute;bottom:18px;right:20px;display:flex;gap:8px;z-index:2;}
  .hero-dot{width:8px;height:8px;border-radius:50%;border:1px solid var(--gold);background:transparent;padding:0;cursor:pointer;}
  .hero-dot.is-active{background:var(--gold);}
  @media (max-width:640px){
    .hero-track{aspect-ratio:4/5;}
    .hero-slide-body{right:0;padding:20px;}
    .hero-slide-body h2{font-size:22px;}
    .hero-arrow{width:30px;height:30px;font-size:16px;}
  }

  .post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px;}
  .post-card.is-more{display:none;}
  .load-more-wrap{text-align:center;margin-top:36px;}
  .post-card{border:1px solid var(--card-border);border-radius:4px;overflow:hidden;background:var(--bg-alt);transition:transform .25s,border-color .25s;display:flex;flex-direction:column;}
  .post-card:hover{transform:translateY(-6px);border-color:var(--gold);}
  .post-cover{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 30% 20%,#1c1712,var(--bg-alt));}
  .post-cover img{width:100%;height:100%;object-fit:cover;}
  .post-body{padding:20px 20px 24px;display:flex;flex-direction:column;gap:10px;flex:1;}
  .post-tag{font-size:11px;letter-spacing:.14em;color:var(--gold);text-transform:uppercase;font-family:Cinzel,serif;}
  .post-card h3{font-size:20px;color:var(--text);margin:0;line-height:1.35;font-weight:600;}
  .post-excerpt{color:var(--text-muted);font-size:15px;line-height:1.55;margin:0;flex:1;}
  .post-meta{font-size:12px;color:var(--text-muted);display:flex;justify-content:space-between;letter-spacing:.03em;}
  .post-meta .read-more{color:var(--gold-bright);}

  /* ritmo visual: 1o post (e a cada 3o depois) ocupa a largura toda, os 2 seguintes ficam lado a lado */
  .post-card:nth-child(3n+1){grid-column:1/-1;}
  .post-card:nth-child(3n+1) .post-cover{aspect-ratio:21/9;}
  .post-card:nth-child(3n+1) h3{font-size:26px;}
  @media (max-width:700px){
    .post-grid{grid-template-columns:1fr;}
    .post-card:nth-child(3n+1) .post-cover{aspect-ratio:16/9;}
    .post-card:nth-child(3n+1) h3{font-size:20px;}
  }

  article.post{max-width:720px;margin:0 auto;}
  .post-hero-meta{text-align:center;margin-bottom:28px;}
  .post-hero-meta .post-tag{display:block;margin-bottom:14px;}
  .post-hero-meta h1{font-size:40px;margin:0 0 16px;line-height:1.2;}
  .byline{font-size:14px;color:var(--text-muted);letter-spacing:.02em;}
  .post-cover-full{width:100%;aspect-ratio:16/9;border:1px solid var(--card-border);border-radius:4px;margin:32px 0 40px;overflow:hidden;background:var(--bg-alt);}
  .post-cover-full img{width:100%;height:100%;object-fit:cover;}
  .post-content p{color:var(--text);margin:0 0 22px;}
  .post-content h2{font-size:26px;color:var(--gold-bright);margin:44px 0 18px;font-weight:600;}
  .post-content ol,.post-content ul{padding-left:26px;margin:0 0 26px;color:var(--text);}
  .post-content li{margin-bottom:14px;padding-left:6px;}
  .post-content li strong{color:var(--gold-bright);font-weight:600;}
  .post-content a{color:var(--gold-bright);border-bottom:1px solid rgba(230,196,103,.4);}
  .post-content img{max-width:100%;border-radius:4px;border:1px solid var(--card-border);}
  .post-figure{margin:0 0 22px;}
  .post-figure img{margin-bottom:8px;}
  .post-figure figcaption{
    font-family:Cinzel,serif;font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--gold);text-align:center;
  }

  .ad-slot{
    border:1px dashed var(--card-border);background:var(--bg-alt);border-radius:4px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
    padding:32px 20px;margin:40px 0;color:var(--text-muted);
  }
  .ad-slot span{font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-family:Cinzel,serif;}

  .cta-box{
    border:1px solid var(--gold);border-radius:4px;padding:36px 32px;margin:48px 0 16px;text-align:center;
    background:linear-gradient(180deg,rgba(201,161,58,.08),transparent);
  }
  .cta-box .post-tag{margin-bottom:10px;}
  .cta-box h3{font-size:24px;margin:0 0 12px;color:var(--text);}
  .cta-box p{color:var(--text-muted);margin:0 0 22px;}
  .cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}

  footer{padding:56px 0 40px;background:var(--bg-alt);border-top:1px solid var(--card-border);}
  .footer-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:32px;}
  footer .brand{display:block;margin-bottom:14px;}
  footer p{color:var(--text-muted);font-size:14px;max-width:360px;margin:0 0 8px;}
  .foot-links{display:flex;gap:20px;flex-wrap:wrap;align-self:flex-start;}
  .foot-links a{font-size:14px;color:var(--text-muted);}
  .foot-links a:hover,.foot-links a.current{color:var(--gold-bright);}

  @media (max-width:640px){
    .sec-head h1{font-size:28px;}
    .post-hero-meta h1{font-size:28px;}
    section{padding:44px 0;}
  }
</style>
</head>
<body>
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand-lockup" aria-label="Domenico Falco, Início">
      <img src="/logo-mark.png" srcset="/logo-mark.png 1x, /logo-mark@2x.png 2x" alt="" width="30" height="30">
      <div class="brand">DOMENICO <span>FALCO</span></div>
    </a>
    <nav class="links">
      <a href="/#sobre">Autor</a>
      <a href="/#obras">Obras</a>
      <a href="/o-mestre-das-tormentas" class="hide-compact">O Mestre das Tormentas</a>
      <a href="/blog" {% if page.url == '/blog/' or '/blog/' in page.url %}class="current"{% endif %}>Blog</a>
      <a href="/#contato">Contato</a>
      <a href="/newsletter">Newsletter</a>
    </nav>
    <a class="cart-btn" href="https://www.amazon.com.br/Livros-DOMENICO-FALCO/s?rh=n%3A6740748011%2Cp_27%3ADOMENICO%2BFALCO" target="_blank" rel="noopener" aria-label="Loja na Amazon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
    </a>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="wrap footer-grid">
    <div>
      <div class="brand">DOMENICO <span>FALCO</span></div>
      <p>Ficção histórica que entrelaça fatos reais a personagens inesquecíveis, do Japão imperial aos sete mares.</p>
      <p style="font-size:12px;">Arte das capas: Júlio Cesar Falco &nbsp;·&nbsp; Revisão: Marylin Falco</p>
    </div>
    <div class="foot-links">
      <a href="https://www.amazon.com.br/Livros-DOMENICO-FALCO/s?rh=n%3A6740748011%2Cp_27%3ADOMENICO%2BFALCO" target="_blank" rel="noopener">Loja na Amazon</a>
      <a href="/#sobre">Sobre o Autor</a>
      <a href="/#obras">Obras</a>
      <a href="/o-mestre-das-tormentas">O Mestre das Tormentas</a>
      <a href="/blog">Blog</a>
      <a href="/newsletter">Newsletter</a>
    </div>
  </div>
</footer>
</body>
</html>
