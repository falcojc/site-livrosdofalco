{# CSS exclusivo dos blocos extras de O Mestre das Tormentas (linha do tempo,
   mapa, curiosidades, personagens ilustrados, momentos e trailer). Recortado
   do HTML artesanal que estava no ar ate 05/09/2026, sem mudar um valor.
   So carrega nesta pagina: as outras PDPs nao pagam por este CSS. #}
  .eyebrow{font-family:'Cinzel',serif;font-size:13px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:18px;}
  .eyebrow::before{content:'';width:34px;height:1px;background:var(--gold);}
  .timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--card-border);margin-top:40px;border:1px solid var(--card-border);}
  .stage{background:var(--bg);}
  .stage img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;}
  .stage-body{padding:22px 20px;}
  .stage .num{font-family:'Cinzel',serif;color:var(--gold);font-size:12px;letter-spacing:.2em;}
  .stage h3{font-family:'Cinzel',serif;font-size:18px;margin-top:8px;}
  .stage p{font-size:15px;color:var(--text-muted);margin-top:8px;}
  .map-wrap{position:relative;margin-top:40px;border:1px solid var(--card-border);background:var(--bg-alt);aspect-ratio:2730/1536;overflow:hidden;}
  .map-wrap img.map-bg{width:100%;height:100%;display:block;object-fit:cover;}
  .pin{position:absolute;transform:translate(-50%,-50%);width:44px;height:44px;cursor:pointer;background:none;border:none;padding:0;display:flex;align-items:center;justify-content:center;}
  .pin::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:22px;height:22px;border-radius:50%;background:var(--gold);border:2px solid #1a1208;box-shadow:0 0 0 3px rgba(201,161,58,.35);transition:background .15s,transform .15s;}
  .pin:hover::before,.pin:focus-visible::before{background:var(--gold-bright);transform:translate(-50%,-50%) scale(1.15);}
  .pin.pin-extra::before{background:var(--red);box-shadow:0 0 0 3px rgba(122,31,31,.35);}
  .pin.pin-extra:hover::before,.pin.pin-extra:focus-visible::before{background:#a83030;}
  .pin .num{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-family:'Cinzel',serif;font-size:10px;color:#1a1208;font-weight:700;}
  .map-popup{position:absolute;max-width:280px;background:var(--card);border:1px solid var(--gold);padding:16px 18px;font-size:14px;color:var(--text);box-shadow:0 12px 30px rgba(0,0,0,.5);display:none;z-index:5;}
  .map-popup.open{display:block;}
  .map-popup .close{position:absolute;top:6px;right:10px;cursor:pointer;color:var(--text-muted);font-size:14px;background:none;border:none;}
  .map-popup .loc{font-family:'Cinzel',serif;color:var(--gold-bright);font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px;}
  .facts{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--card-border);margin-top:36px;border:1px solid var(--card-border);}
  .fact{background:var(--bg);padding:26px 28px;}
  .fact .loc{font-family:'Cinzel',serif;font-size:12px;color:var(--gold);letter-spacing:.14em;text-transform:uppercase;}
  .fact p{margin-top:10px;font-size:16px;color:var(--text-muted);}
  .fact p strong{color:var(--text);font-weight:600;}
  .chars{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:36px;}
  .char img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;border:1px solid var(--card-border);}
  .char h3{font-family:'Cinzel',serif;font-size:20px;margin-top:16px;}
  .char .role{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-top:4px;}
  .char p{font-size:16px;color:var(--text-muted);margin-top:10px;}
  .moments{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:36px;}
  .moment{background:var(--card);border:1px solid var(--card-border);}
  .moment img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;}
  .moment-body{padding:20px 22px;}
  .moment h3{font-family:'Cinzel',serif;font-size:17px;}
  .moment p{font-size:15px;color:var(--text-muted);margin-top:8px;}
  .trailer{margin-top:36px;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;}
  .trailer video{width:100%;aspect-ratio:16/9;background:#000;}
  .trailer h3{font-family:'Cinzel',serif;font-size:24px;}
  .trailer p{color:var(--text-muted);margin-top:14px;}
  .trailer .cap-note{font-size:13px;color:var(--gold);margin-top:14px;}
  section.trailer{padding-bottom:28px;}
  section.why{padding-top:28px;}
  .why{margin-top:36px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px 40px;}
  .why-item{display:flex;gap:16px;}
  .why-item .mark{font-family:'Cinzel',serif;color:var(--gold);font-size:22px;line-height:1;}
  .why-item p{font-size:16px;color:var(--text-muted);}
  .family{background:var(--bg-alt);border-top:1px solid var(--card-border);border-bottom:1px solid var(--card-border);}
  .family .wrap{text-align:center;max-width:760px;}
  .family p{font-size:18px;color:var(--text-muted);}
  .family p strong{color:var(--gold-bright);font-weight:600;}
@media (max-width:860px){
  .books,.chars,.why,.trailer,.moments{grid-template-columns:1fr;}
  .timeline{grid-template-columns:1fr 1fr;}
  .facts{grid-template-columns:1fr;}
}

  {# Testado e descartado em 05/09/2026: content-visibility:auto nos blocos
     extras derrubou o trabalho de main thread, mas a altura estimada
     (contain-intrinsic-size) nao bate com a real e a barra de rolagem passa
     a saltar no meio da leitura. Numa pagina de 15 mil pixels isso e pior
     que o ganho, que a medicao nao confirmou. #}
