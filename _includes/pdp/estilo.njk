{# CSS das paginas de obra. Vale para as 30, entao nada aqui pode depender de
   uma obra especifica. O que e exclusivo de uma obra vive em pdp/extras-*. #}
  .pdp main{display:block;}
  .pdp-wrap{max-width:1080px;margin:0 auto;padding:0 22px;}
  .pdp-sec{padding:46px 0;}
  .pdp-sec.alt{background:var(--bg-alt);border-top:1px solid var(--card-border);border-bottom:1px solid var(--card-border);}
  .pdp-kicker{font-family:Cinzel,serif;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);margin:0 0 10px;}
  .pdp-sec h2{font-size:26px;margin:0 0 22px;font-weight:600;line-height:1.25;}
  .pdp-texto{max-width:70ch;}

  /* trilha: primeiro elemento da pagina, precisa ser discreta e clicavel com folga */
  .pdp-crumb{font-size:13px;color:var(--text-muted);padding:14px 0 0;}
  .pdp-crumb a{color:var(--text-muted);border-bottom:1px solid transparent;}
  .pdp-crumb a:hover{color:var(--gold-bright);border-bottom-color:currentColor;}
  .pdp-crumb span{opacity:.5;margin:0 6px;}

  /* heroi */
  .pdp-hero{position:relative;padding:26px 0 40px;overflow:hidden;}
  /* Video de atmosfera: so em tela grande. Medido em 05/09/2026 no heroi de
     O Mestre das Tormentas: no celular o mp4 de 4,1 MB virava o elemento de
     LCP e derrubava a pagina para 71 no PageSpeed, contra 88 das outras.
     display:none tambem impede o download do poster de 100 KB. */
  .pdp-hero-video,.pdp-hero-scrim{display:none;}
  @media (min-width:900px){
    .pdp-hero-video{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
    .pdp-hero-scrim{display:block;}
  }
  /* o video de atmosfera fica atras do texto, entao o veu precisa ser forte:
     medido no heroi de O Mestre das Tormentas, com veu mais claro o titulo da
     arte competia com as coordenadas da obra. */
  .pdp-hero-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(11,9,8,.88),rgba(11,9,8,.96));}
  /* celular: capa e titulo lado a lado; gancho, coordenadas e botao ocupam a largura toda.
     Medido em 375px: com tudo numa coluna de 200px o titulo quebrava em 3 linhas. */
  .pdp-hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:118px 1fr;gap:16px 18px;align-items:start;}
  .pdp-hero-acao{grid-column:1 / -1;}
  .pdp-capa{border:1px solid var(--card-border);border-radius:3px;overflow:hidden;background:var(--bg-alt);box-shadow:0 18px 40px rgba(0,0,0,.55);}
  .pdp-capa img{display:block;width:100%;height:auto;}
  .pdp-hero h1{font-size:32px;line-height:1.15;margin:0 0 10px;font-weight:600;}
  .pdp-sub{color:var(--text-muted);font-size:17px;margin:0 0 18px;max-width:52ch;}
  .pdp-gancho{font-size:19px;line-height:1.5;margin:0 0 20px;max-width:48ch;border-left:2px solid var(--gold);padding-left:16px;}
  .pdp-tagline{font-style:italic;color:var(--gold-bright);font-size:14px;margin:0 0 12px;}

  /* coordenadas da obra: quando, onde, quanto. E o que a leitora de ficcao
     historica procura antes de decidir, entao ganha tratamento de placa. */
  .pdp-coord{display:flex;flex-wrap:wrap;gap:0;margin:0 0 22px;border-top:1px solid var(--card-border);border-bottom:1px solid var(--card-border);}
  .pdp-coord div{padding:12px 20px 12px 0;margin-right:20px;border-right:1px solid var(--card-border);}
  .pdp-coord div:last-child{border-right:0;margin-right:0;padding-right:0;}
  .pdp-coord dt{font-family:Cinzel,serif;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);margin:0 0 4px;}
  .pdp-coord dd{margin:0;font-size:15px;color:var(--text);}

  .pdp-ctas{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
  /* o .btn do nucleo e white-space:nowrap, feito para rotulo curto de menu.
     Num CTA de PDP o rotulo e uma frase, e sem isto ele estoura a caixa. */
  .pdp-ctas .btn{padding:12px 22px;font-size:13px;white-space:normal;max-width:100%;line-height:1.4;}
  .pdp-selo{display:inline-flex;align-items:center;gap:7px;font-family:Cinzel,serif;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-bright);border:1px dashed rgba(201,161,58,.55);border-radius:2px;padding:8px 12px;}
  .pdp-nota{font-size:13px;color:var(--text-muted);margin:14px 0 0;}

  /* sinopse e volumes */
  .pdp-sinopse p{margin:0 0 18px;}
  .pdp-vols{display:grid;gap:16px;margin-top:26px;}
  .pdp-vol{border:1px solid var(--card-border);border-radius:4px;padding:20px 22px;background:var(--bg-alt);}
  .pdp-vol .num{font-family:Cinzel,serif;font-size:11px;letter-spacing:.2em;color:var(--gold);text-transform:uppercase;}
  .pdp-vol h3{font-size:19px;margin:8px 0 4px;font-weight:600;}
  .pdp-vol .linha{font-size:13px;color:var(--gold-bright);margin:0 0 10px;}
  .pdp-vol p{margin:0;color:var(--text-muted);font-size:15px;line-height:1.6;}

  /* temas, epoca, local */
  .pdp-chips{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 22px;}
  .pdp-chip{border:1px solid var(--card-border);border-radius:999px;padding:8px 16px;font-size:14px;color:var(--text);background:var(--bg-alt);}
  .pdp-chip.gold{border-color:rgba(201,161,58,.5);color:var(--gold-bright);}
  .pdp-lista{list-style:none;padding:0;margin:0;display:grid;gap:12px;}
  .pdp-lista li{padding-left:20px;position:relative;color:var(--text-muted);}
  .pdp-lista li::before{content:"—";position:absolute;left:0;color:var(--gold);}

  /* personagens */
  .pdp-pers{display:grid;gap:14px;}
  .pdp-pers div{border-left:2px solid var(--card-border);padding-left:16px;}
  .pdp-pers strong{display:block;font-family:Cinzel,serif;font-size:15px;color:var(--gold-bright);letter-spacing:.04em;margin-bottom:4px;}
  .pdp-pers p{margin:0;font-size:15px;color:var(--text-muted);}

  /* midia: audio nativo e fachada do YouTube (o iframe so entra no clique) */
  .pdp-midia{display:grid;gap:18px;}
  .pdp-audio{border:1px solid var(--gold);border-radius:4px;padding:16px 18px;}
  .pdp-audio .rot{font-family:Cinzel,serif;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:10px;}
  .pdp-audio audio{width:100%;}
  .pdp-yt{position:relative;border:1px solid var(--card-border);border-radius:4px;overflow:hidden;background:var(--bg-alt);cursor:pointer;width:100%;padding:0;display:block;}
  .pdp-yt img,.pdp-yt iframe{display:block;width:100%;aspect-ratio:16/9;height:auto;border:0;object-fit:cover;}
  .pdp-yt .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
  .pdp-yt .play span{width:64px;height:44px;border-radius:8px;background:rgba(11,9,8,.72);border:1px solid var(--gold);color:var(--gold-bright);display:flex;align-items:center;justify-content:center;font-size:18px;}
  .pdp-yt:hover .play span{background:var(--gold);color:var(--bg);}
  .pdp-legenda{font-size:13px;color:var(--text-muted);margin:10px 0 0;}

  /* post do blog e obras relacionadas */
  .pdp-cards{display:grid;gap:16px;}
  .pdp-card{display:flex;gap:16px;align-items:center;border:1px solid var(--card-border);border-radius:4px;background:var(--bg-alt);padding:14px;transition:border-color .2s,transform .2s;}
  .pdp-card:hover{border-color:var(--gold);transform:translateY(-3px);}
  .pdp-card img{width:112px;height:74px;object-fit:cover;border-radius:3px;flex-shrink:0;}
  .pdp-card .tit{font-family:Cinzel,serif;font-size:15px;line-height:1.35;color:var(--text);margin:0 0 4px;}
  .pdp-card .sub{font-size:13px;color:var(--text-muted);margin:0;}
  .pdp-rel{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .pdp-rel a{display:block;text-align:center;}
  .pdp-rel img{width:100%;height:auto;border:1px solid var(--card-border);border-radius:3px;background:var(--bg-alt);transition:border-color .2s;}
  .pdp-rel a:hover img{border-color:var(--gold);}
  .pdp-rel .tit{font-family:Cinzel,serif;font-size:14px;margin:10px 0 0;line-height:1.3;}

  /* FAQ: details nativo, sem JS, abre com teclado de graca */
  .pdp-faq{max-width:70ch;}
  .pdp-faq details{border-bottom:1px solid var(--card-border);padding:4px 0;}
  .pdp-faq summary{cursor:pointer;padding:14px 28px 14px 0;font-family:Cinzel,serif;font-size:16px;color:var(--text);position:relative;list-style:none;}
  .pdp-faq summary::-webkit-details-marker{display:none;}
  .pdp-faq summary::after{content:"+";position:absolute;right:4px;top:12px;color:var(--gold);font-size:20px;line-height:1;}
  .pdp-faq details[open] summary::after{content:"–";}
  .pdp-faq summary:hover{color:var(--gold-bright);}
  .pdp-faq p{margin:0 0 16px;color:var(--text-muted);}

  /* fechamento */
  .pdp-final{text-align:center;border:1px solid var(--gold);border-radius:4px;padding:34px 26px;background:linear-gradient(180deg,rgba(201,161,58,.08),transparent);}
  .pdp-final h2{margin-bottom:12px;}
  .pdp-final p{color:var(--text-muted);max-width:60ch;margin:0 auto 22px;}
  .pdp-final .pdp-ctas{justify-content:center;}

  #back-to-top{position:fixed;right:18px;bottom:18px;width:42px;height:42px;border-radius:50%;border:1px solid var(--gold);background:rgba(11,9,8,.85);color:var(--gold-bright);display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;visibility:hidden;transition:opacity .2s,visibility .2s;z-index:20;}
  #back-to-top.visible{opacity:1;visibility:visible;}
  #back-to-top svg{width:18px;height:18px;}

  @media (min-width:760px){
    .pdp-wrap{padding:0 28px;}
    .pdp-sec{padding:56px 0;}
    .pdp-hero{padding:34px 0 52px;}
    .pdp-hero-grid{grid-template-columns:260px 1fr;gap:26px 44px;}
    .pdp-capa{grid-row:span 2;}
    .pdp-hero-acao{grid-column:2;}
    .pdp-hero h1{font-size:44px;}
    .pdp-sec h2{font-size:30px;}
    .pdp-gancho{font-size:21px;}
    .pdp-vols{grid-template-columns:repeat(3,1fr);}
    .pdp-cards.duplo{grid-template-columns:repeat(2,1fr);}
  }
  @media (max-width:759px){
    .pdp-hero h1{font-size:23px;}
    .pdp-sub{font-size:15px;margin-bottom:14px;}
    .pdp-gancho{font-size:17px;}
    .pdp-coord{display:grid;grid-template-columns:1fr 1fr;}
    .pdp-coord div{padding:10px 14px;margin:0;border-right:1px solid var(--card-border);border-bottom:1px solid var(--card-border);}
    .pdp-coord div:nth-child(2n){border-right:0;padding-right:0;}
    .pdp-coord div:nth-child(2n+1){padding-left:0;}
    .pdp-coord div:nth-last-child(-n+2){border-bottom:0;}
    /* no celular os dois CTAs ficam empilhados e do mesmo tamanho. O rotulo
       maior cabe em uma linha com o espacamento um pouco mais fechado. */
    .pdp-ctas .btn{flex:1 1 100%;text-align:center;letter-spacing:.08em;padding:12px 14px;}
    .pdp-selo{flex:1 1 100%;justify-content:center;}
    .pdp-rel{grid-template-columns:repeat(3,1fr);gap:10px;}
    .pdp-rel .tit{font-size:12px;}
    .pdp-card img{width:88px;height:60px;}
  }
  @media (prefers-reduced-motion:reduce){
    .pdp-card,.pdp-rel img{transition:none;}
  }

  /* O cabecalho fixo do site usa backdrop-filter:blur, que o celular compoe a
     cada quadro de rolagem. Numa pagina longa isso custa caro e o ganho visual
     e minimo: o fundo ja e quase opaco. Nas PDPs ele vira cor solida. */
  .pdp header.nav{backdrop-filter:none;background:rgba(11,9,8,.98);}
